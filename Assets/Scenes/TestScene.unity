  m_Script: {fileID: 11500000, guid: 662bbd4249abe3140ba2c86ce9b24e91, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestManager
  questItems:
  - itemId: Keyboard
    displayName: Keyboard
    memoryLine: I remember the first line of code ever typed on this floor. It was in Python. It didn't compile. We were all very proud anyway.
  - itemId: ITPoster
    displayName: IT Poster
    memoryLine: I was installed the year the Informatics major started 2021. There were only blabla students then. Look at us now.
  - itemId: Whiteboard
    displayName: Whiteboard
    memoryLine: omeone drew Hatsune Miku on this board and nobody erased it for weeks. That's when I knew this floor had a personality.
  - itemId: Plaque
    displayName: Plaque
    memoryLine: This plaque marks `[the floor's opening / a founder / an award]`. I remember the day it went up. There was `[free food / a speech / a very long speech]`.
  - itemId: Printer3D
    displayName: 3D Printer
    memoryLine: I've watched `[N]` student projects get printed here. Some worked. Some became `[paperweights / art / cautionary tales]`.
  allowMemoryReplay: 1
  logScans: 1
